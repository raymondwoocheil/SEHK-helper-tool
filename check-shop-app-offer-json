                    if (urlRegex.test(text)) {
                        let newHTML = text.replace(urlRegex, function(url) {
                            let href = url.startsWith('www.') ? 'http://' + url : url;
                            return `<a href="${href}" target="_blank">${url}</a>`;
                        });
                        let tempDiv = document.createElement('div');
                        tempDiv.innerHTML = newHTML;
                        while (tempDiv.firstChild) {
                            node.parentNode.insertBefore(tempDiv.firstChild, node);
                        }
                        node.parentNode.removeChild(node);
                    }
                } else if (node.nodeType === 1 && !['SCRIPT', 'STYLE', 'A'].includes(node.tagName)) {
                    // Recursively process child nodes, excluding script, style, and anchor tags
                    Array.from(node.childNodes).forEach(walkTextNodes);
                }
            }

            // Start processing from body
            walkTextNodes(document.body);
        });
        */

        document.getElementById('convertUrls').addEventListener('click', function() {
            // Function to walk through text nodes
            function walkTextNodes(node) {
                if (node.nodeType === 3) { // Text node
                    let text = node.textContent;
                    // Regex to match only www.samsung.com URLs
                    let urlRegex = /(https?:\/\/www\.samsung\.com(?:\/[^\s<>"']*)?|www\.samsung\.com(?:\/[^\s<>"']*)?)/g;
                    if (urlRegex.test(text)) {
                        let newHTML = text.replace(urlRegex, function(url) {
                            let href = url.startsWith('www.') ? 'https://' + url : url;
                            return `<a href="${href}" target="_blank">${url}</a>`;
                        });
                        let tempDiv = document.createElement('div');
                        tempDiv.innerHTML = newHTML;
                        while (tempDiv.firstChild) {
                            node.parentNode.insertBefore(tempDiv.firstChild, node);
                        }
                        node.parentNode.removeChild(node);
                    }
                } else if (node.nodeType === 1 && !['SCRIPT', 'STYLE', 'A'].includes(node.tagName)) {
                    // Recursively process child nodes, excluding script, style, and anchor tags
                    Array.from(node.childNodes).forEach(walkTextNodes);
                }
            }

            // Start processing from body
            walkTextNodes(document.body);
        });
        
        document.getElementById('convertImageUrls').addEventListener('click', function() {
            // Function to walk through text nodes
            function walkTextNodes(node) {
                if (node.nodeType === 3) { // Text node
                    let text = node.textContent;
                    // Regex to match URLs containing p1-img-mobile-cdn
                    let urlRegex = /(https?:\/\/[^\s<>"']*p1-img-mobile-cdn[^\s<>"']*\.(?:jpg|png|gif|jpeg))/gi;
                    if (urlRegex.test(text)) {
                        let newHTML = text.replace(urlRegex, function(url) {
                            return `<img src="${url}" class="converted-image" alt="Converted image" data-url="${url}">`;
                        });
                        let tempDiv = document.createElement('div');
                        tempDiv.innerHTML = newHTML;
                        while (tempDiv.firstChild) {
                            node.parentNode.insertBefore(tempDiv.firstChild, node);
                        }
                        node.parentNode.removeChild(node);
                    }
                } else if (node.nodeType === 1 && !['SCRIPT', 'STYLE', 'IMG'].includes(node.tagName)) {
                    // Recursively process child nodes, excluding script, style, and img tags
                    Array.from(node.childNodes).forEach(walkTextNodes);
                }
            }

            // Start processing from body
            walkTextNodes(document.body);

            // Add click event listeners to all converted images
            document.querySelectorAll('.converted-image').forEach(img => {
                img.addEventListener('click', function() {
                    window.open(this.getAttribute('data-url'), '_blank');
                });
            });
        });
    </script>
</body>
</html>
